{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://your-next-app.example.com",
          "http://localhost:3000",
          "http://127.0.0.1:3000"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["range", "if-none-match", "if-modified-since"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
