{
  "name": "clover",
  "version": "0.1.0",
  "description": "A cloud file storage and management app built with Next.js, Cloudflare Workers, D1, and R2.",
  "private": true,
  "license": "MIT",
  "author": "satyalyadav",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/satyalyadav/clover_storage.git"
  },
  "bugs": {
    "url": "https://github.com/satyalyadav/clover_storage/issues"
  },
  "homepage": "https://github.com/satyalyadav/clover_storage#readme",
  "keywords": [
    "nextjs",
    "cloudflare-workers",
    "cloudflare-d1",
    "cloudflare-r2",
    "file-storage"
  ],
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "preview": "next dev",
    "backend:dev": "wrangler dev",
    "backend:deploy": "wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "r2:cors:set": "wrangler r2 bucket cors set clover-files --file r2-cors.json",
    "r2:cors:list": "wrangler r2 bucket cors list clover-files",
    "db:migrations:apply": "wrangler d1 migrations apply clover-db --local",
    "db:migrations:apply:remote": "wrangler d1 migrations apply clover-db --remote",
    "backup:d1": "node scripts/backup-d1-to-r2.mjs",
    "cleanup:uploads": "node scripts/cleanup-pending-uploads.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.15",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "input-otp": "^1.4.2",
    "jsmediatags": "^3.9.7",
    "jszip": "^3.10.1",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.68.0",
    "resend": "^6.12.2",
    "tailwind-merge": "^2.6.0",
    "use-debounce": "^10.0.6",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260430.1",
    "@eslint/eslintrc": "^3.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.6",
    "postcss": "8.5.14",
    "tailwindcss": "^3.4.18",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "wrangler": "^4.90.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.27.3"
    },
    "next": {
      "postcss": "8.5.14"
    }
  }
}
