AUTH_COOKIE_NAME=clover-session
CLOVER_BACKEND_URL=http://localhost:8787
CLOVER_BACKEND_SECRET=replace_with_a_long_random_shared_secret
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Worker secrets are configured with `wrangler secret put`.
# These are shown here as documentation for local setup only.
AUTH_HASH_PEPPER=replace_with_a_long_random_hash_pepper
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=

# Optional operations/script credentials. Keep real values in your shell or CI secrets.
CLOVER_D1_DATABASE=clover-db
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=clover-files
BACKUPS_R2_BUCKET_NAME=clover-backups
PENDING_UPLOAD_MAX_AGE_MINUTES=60
